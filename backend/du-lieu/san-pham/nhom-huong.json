  {
    "NHÓM HƯƠNG": "01",
    "Unnamed: 1": "Woody & Smoky",
    "Unnamed: 2": 7,
    "Unnamed: 3": 605,
    "Unnamed: 4": 0.157593123209169,
    "Unnamed: 5": 4,
    "Unnamed: 6": null,
    "Unnamed: 7": "Gỗ Ấm Áp & Khói Trầm",
    "Unnamed: 8": "Sâu lắng, quyền uy, bền bỉ và ấm áp. Lấy cảm hứng từ những cánh rừng tuyết tùng ngàn năm và làn khói nhũ hương thiền định tĩnh lặng.",
    "Unnamed: 9": "Đàn hương Mysore, Tuyết tùng Atlas, Hoắc hương hun khói, Nhũ hương Oman",
    "Unnamed: 10": "Trầm ổn, quyền lực, bí ẩn, gợi cảm giác tĩnh tại.",
    "Unnamed: 11": "Santal 33",
    "Unnamed: 12": 5900000
  },
  {
    "NHÓM HƯƠNG": "02",
    "Unnamed: 1": "Floral & Powdery",
    "Unnamed: 2": 8,
    "Unnamed: 3": 847,
    "Unnamed: 4": 0.220630372492837,
    "Unnamed: 5": 1,
    "Unnamed: 6": "NHÓM BÁN CHẠY NHẤT",
    "Unnamed: 7": "Hoa Cỏ Tinh Khiết & Tao Nhã",
    "Unnamed: 8": "Dịu dàng, sang trọng và tràn đầy sức sống như bình minh sớm phủ sương mai tại thung lũng hoa Grasse nước Pháp.",
    "Unnamed: 9": "Hoa Iris Florence, Hồng Centifolia, Nhài Sambac, Mẫu đơn trắng",
    "Unnamed: 10": "Duyên dáng, thanh lịch, rạng rỡ, thơ mộng.",
    "Unnamed: 11": "Bal d'Afrique",
    "Unnamed: 12": 4750000
  },
  {
    "NHÓM HƯƠNG": "03",
    "Unnamed: 1": "Amber & Gourmand",
    "Unnamed: 2": 4,
    "Unnamed: 3": 536,
    "Unnamed: 4": 0.139619692628289,
    "Unnamed: 5": 5,
    "Unnamed: 6": null,
    "Unnamed: 7": "Hổ Phách & Gia Vị Đông Phương",
    "Unnamed: 8": "Ngọt ngào, nồng nàn và say đắm. Tạo vệt hương dày dặn, ấm áp kéo dài trong buổi tối đêm sang trọng.",
    "Unnamed: 9": "Hổ phách vàng, Vani đen Bourbon, Đậu Tonka rang, Nhựa bồ đề Benzoin",
    "Unnamed: 10": "Quyến rũ, gợi cảm, say đắm, tiệc đêm.",
    "Unnamed: 11": "Sauvage Elixir",
    "Unnamed: 12": 6200000
  },
  {
    "NHÓM HƯƠNG": "04",
    "Unnamed: 1": "Citrus & Aromatic",
    "Unnamed: 2": 6,
    "Unnamed: 3": 502,
    "Unnamed: 4": 0.130763219588434,
    "Unnamed: 5": 6,
    "Unnamed: 6": null,
    "Unnamed: 7": "Tươi Mát Cam Chanh & Thảo Mộc",
    "Unnamed: 8": "Sáng, sạch và tràn năng lượng như vườn cam chanh dưới nắng Địa Trung Hải, điểm thêm thảo mộc xanh mát.",
    "Unnamed: 9": "Cam bergamot Calabria, Chanh Amalfi, Oải hương, Hương thảo",
    "Unnamed: 10": "Tươi tỉnh, thanh thoát, năng động, gần gũi.",
    "Unnamed: 11": "Bergamote 22",
    "Unnamed: 12": 5600000
  },
  {
    "NHÓM HƯƠNG": "05",
    "Unnamed: 1": "Aquatic & Green",
    "Unnamed: 2": 7,
    "Unnamed: 3": 735,
    "Unnamed: 4": 0.191456108361553,
    "Unnamed: 5": 2,
    "Unnamed: 6": "TOP 2",
    "Unnamed: 7": "Cỏ Xanh & Đại Dương Trong Lành",
    "Unnamed: 8": "Trong trẻo như gió biển và cỏ ướt sương, mang lại cảm giác thoáng đãng và tự do.",
    "Unnamed: 9": "Rong biển, Muối biển, Cỏ xanh, Lá cây ướt sương",
    "Unnamed: 10": "Tự do, trong lành, thư thái, tự nhiên.",
    "Unnamed: 11": "Beach Walk",
    "Unnamed: 12": 3850000
  },
  {
    "NHÓM HƯƠNG": "06",
    "Unnamed: 1": "Leather & Clean Musk",
    "Unnamed: 2": 5,
    "Unnamed: 3": 614,
    "Unnamed: 4": 0.159937483719719,
    "Unnamed: 5": 3,
    "Unnamed: 6": "TOP 3",
    "Unnamed: 7": "Da Thuộc & Xạ Hương Thuần Chay",
    "Unnamed: 8": "Cảm giác làn da thuộc mịn mượt như nhung, kết hợp xạ hương thực vật tinh khiết vương vấn trên da.",
    "Unnamed: 9": "Da lộn Tuscan, Clean Musk thuần chay, Rễ diên vĩ Orris, Khói lá khô",
    "Unnamed: 10": "Sang trọng, thầm lặng, cá tính ngầm, trưởng thành.",
    "Unnamed: 11": "Mojave Ghost",
    "Unnamed: 12": 4750000
