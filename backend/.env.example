# Sao chép thành .env rồi điền giá trị (tệp .env KHÔNG đưa lên GitHub).
# Chuỗi kết nối MongoDB Atlas — thêm tên CSDL "scentory" ngay sau ".mongodb.net/"
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/scentory?retryWrites=true&w=majority
PORT=3000
NODE_ENV=development
# Chuỗi bí mật ký JWT, tối thiểu 32 ký tự: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
# Danh sách origin được gọi API (để trống = cho phép cùng origin khi chạy máy cá nhân)
CORS_ORIGIN=
# SMTP gửi OTP (tùy chọn; để trống → OTP được in ra cửa sổ máy chủ)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
