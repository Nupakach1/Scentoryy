{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd backend && npm ci --include=dev && cd ../frontend && npm ci --include=dev",
  "buildCommand": "cd frontend && npx ng build",
  "outputDirectory": "frontend/dist/scentory/browser",
  "functions": { "api/index.ts": { "maxDuration": 15 } },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
